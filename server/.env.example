DATABASE_URL="postgresql://user:password@localhost:5432/chronicles_rebuild?sslmode=require"
CLIENT_URL="http://localhost:5173"
PORT=3001
NODE_ENV=development
# In production set NODE_ENV=production, CLIENT_URL to the https address of the
# site, and the key below. With NODE_ENV=development the session cookies are not
# Secure, proxy headers are ignored (every visitor then shares one rate limit
# behind a reverse proxy) and REGISTRATION_WHITELIST is honoured — never run a
# public server that way.

# Google Calendar sync (create OAuth credentials at console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/google/callback"
# 32 random bytes, base64 — encrypts stored refresh tokens, 2FA secrets and
# Remember me grants at rest (set it in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (SECRETS_ENCRYPTION_KEY is accepted as an alias for this value)
CALENDAR_TOKEN_KEY=""

# Number of reverse-proxy hops in front of the server (Render: 1). Defaults to 1
# in production and off in development. Set to 0 if the server is exposed directly.
# TRUST_PROXY=1

# Sign-up is closed: only emails approved on the beta list
# (npm run beta -- --approve <email>) can create an account. Outside production, optionally list
# extra emails here (comma-separated). REGISTRATION_OPEN=true lets anyone sign
# up — each account gets its own database schema.
# REGISTRATION_WHITELIST="you@example.com"
# REGISTRATION_OPEN=true
# The app's address, for the sign-up links `npm run beta -- --approve` prints
# (falls back to CLIENT_URL)
# APP_URL="https://chronicles.example.com"

# Passkeys are tied for good to the domain they were made on. By default that
# is the host of APP_URL (else CLIENT_URL): set it before the first passkey is
# added and don't change it after. Set WEBAUTHN_RP_ID only to use a parent
# domain (example.com for app.example.com).
# WEBAUTHN_RP_ID="chronicles.example.com"

# Per-account storage caps in MB (all entries are sent to the browser at once,
# so this also bounds that response). Defaults: 200 for entries, 50 for finance.
# ENTRY_STORAGE_LIMIT_MB=200
# FINANCE_STORAGE_LIMIT_MB=50

# Bug reports (/report-a-bug, Settings → Report a Bug) are emailed to support through Resend.
# Unset: the form opens the reporter's own email app instead. FROM must be on a domain verified in Resend.
RESEND_API_KEY=
BUG_REPORT_FROM="Chronicles bug reports <bugs@mydailychronicles.com>"
BUG_REPORT_TO=support@mydailychronicles.com
# Beta invitations: `npm run beta -- --approve <email>` emails the welcome email with their sign-up link
# through Resend (needs RESEND_API_KEY and APP_URL). FROM must be on a domain verified in Resend.
WELCOME_EMAIL_FROM="Chronicles <hello@mydailychronicles.com>"
WELCOME_EMAIL_SIGNOFF=Chronicles

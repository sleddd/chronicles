DATABASE_URL="postgresql://user:password@localhost:5432/chronicles_rebuild?sslmode=require"
CLIENT_URL="http://localhost:5173"
PORT=3001
NODE_ENV=development

# Google Calendar sync (create OAuth credentials at console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Must match the redirect URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI="http://localhost:3001/api/calendar/google/callback"
# 32 random bytes, base64 — encrypts stored refresh tokens at rest
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# (SECRETS_ENCRYPTION_KEY is accepted as an alias for this value)
CALENDAR_TOKEN_KEY=""

# Number of reverse-proxy hops in front of the server (Render: 1). Defaults to 1
# in production and off in development. Set to 0 if the server is exposed directly.
# TRUST_PROXY=1
